# Backend en la maquina, para desarrollo. El emulador de Android no ve
# `localhost` como el host: `10.0.2.2` es su alias.
#   flutter run --dart-define-from-file=.env.local
API_BASE_URL=http://10.0.2.2:3000/api/v1

# Cliente OAuth de tipo Web de Google Cloud. No es un secreto: viaja dentro
# del APK. Los clientes de tipo Android NO van aqui.
GOOGLE_SERVER_CLIENT_ID=876525132415-oatsdq5iov3fsiho48vv0sd67qt49n27.apps.googleusercontent.com
