# Constantes de compilacion. Se leen con:
#   flutter run --dart-define-from-file=.env
#
# No es un .env de servidor: Flutter no lo lee en tiempo de ejecucion, lo
# incrusta al compilar. Por eso aqui **no va ningun secreto** — cualquiera que
# tenga el APK puede sacar lo que este en este archivo.
API_BASE_URL=https://cam-run.tumype.com/api/v1

# Cliente OAuth de tipo Web de Google Cloud. No es un secreto: viaja dentro
# del APK. Los clientes de tipo Android NO van aqui.
GOOGLE_SERVER_CLIENT_ID=876525132415-oatsdq5iov3fsiho48vv0sd67qt49n27.apps.googleusercontent.com
